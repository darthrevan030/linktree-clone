---
/**
 * PostHog analytics, loaded without blocking first paint.
 *
 * - Requests go through /insights/* (see vercel.json), so they are
 *   same-origin: first-party, and not matched by blocker hostname lists.
 * - Persistent visitor ID (localStorage + cookie), so one person's pageviews,
 *   clicks and recording stitch together and return visits are recognised.
 *   This sets cookies — see README → Analytics.
 * - Session recording is on. On the private card page its payload gets a deep
 *   scrub, because the card key sits in the URL rrweb records.
 * - ONE delegated click listener reads data-ph-* attributes produced by
 *   src/lib/analytics.ts, so adding a link never adds JavaScript.
 *
 * If PUBLIC_POSTHOG_KEY is unset (e.g. local dev), this is a silent no-op.
 */
---

<script>
  import type { PostHog } from 'posthog-js';
  import { scrubCardPaths, scrubCardPathsDeep, isCardPath } from '../lib/analytics';

  const key = import.meta.env.PUBLIC_POSTHOG_KEY;
  /** "nfc-card" on the private card page, so taps are attributable. */
  const source = document.documentElement.dataset.source;
  /** Recordings of this page embed the card key, so they need the deep scrub. */
  const onCardPage = isCardPath(location.pathname);

  type Pending = { event: string; props: Record<string, string> };

  let client: PostHog | null = null;
  const queue: Pending[] = [];

  function send(event: string, props: Record<string, string>) {
    if (client) client.capture(event, props);
    else queue.push({ event, props });
  }

  async function load() {
    const { default: posthog } = await import('posthog-js');
    posthog.init(key, {
      api_host: '/insights',
      ui_host: 'https://eu.posthog.com',
      persistence: 'localStorage+cookie',
      // 'always' so anonymous visitors get a person profile. Without one there
      // is no timeline tying a visitor's pageviews, clicks and return visits
      // together, which is the whole point of seeing who clicked what.
      person_profiles: 'always',
      autocapture: false,
      disable_session_recording: false,
      capture_pageview: true,
      capture_pageleave: true,
      // Local testing sends real events (via the dev proxy in astro.config.mjs).
      // Tag them so they can be filtered out of real traffic in PostHog.
      loaded: (ph) => {
        if (import.meta.env.DEV) ph.register({ environment: 'development' });
      },
      // The card URL contains the private key; strip it from every event so
      // the key is never stored in PostHog. Recordings hide it one level down,
      // inside the rrweb payload, where the property-level scrub cannot reach.
      before_send: (event) => {
        if (!event?.properties) return event;
        event.properties = scrubCardPaths(event.properties);
        if (onCardPage && event.event === '$snapshot' && event.properties.$snapshot_data) {
          event.properties.$snapshot_data = scrubCardPathsDeep(event.properties.$snapshot_data);
        }
        return event;
      },
    });
    if (source) posthog.register({ source });
    client = posthog;
    // Flush anything clicked while the library was still loading.
    for (const { event, props } of queue.splice(0)) client.capture(event, props);
  }

  if (key) {
    // Attach the listener immediately so early clicks are queued, not lost.
    document.addEventListener('click', (e) => {
      const el = (e.target as Element | null)?.closest<HTMLElement>('[data-ph-event]');
      if (!el) return;
      const d = el.dataset;
      send(d.phEvent!, {
        label: d.phLabel ?? '',
        destination: d.phDest ?? '',
        kind: d.phKind ?? '',
        surface: d.phSurface ?? '',
      });
    });

    // Defer the library itself until the browser is idle, capped so it still
    // loads promptly on busy pages. It never competes with first paint.
    const start = () => void load();
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 2000 });
    } else {
      setTimeout(start, 1500);
    }
  }
</script>
