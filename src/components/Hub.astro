---
/**
 * The hub: a circuit board with chip U1 at the centre.
 *
 * Rendered by the public home page and by the private NFC card page. The only
 * differences are which contact file "Save contact" serves, and whether the
 * phone number is shown (card page only).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Pin from './LinkButton.astro';
import { profile } from '../data/profile';
import { links } from '../data/links';
import { socials } from '../data/socials';
import { toDataAttrs, CONTACT_SAVE_EVENT, LINK_CLICK_EVENT } from '../lib/analytics';

interface Props {
  contactHref: string;
  /** Private card page only. */
  phone?: string;
}

const { contactHref, phone } = Astro.props;
const surface = Astro.url.pathname;

// Eager glob rather than a static import: resolves to {} when the photo is
// absent, so the build still succeeds and the initials fallback renders.
// The file is a face-centred crop generated by scripts/crop-avatar.mjs (prebuild)
// from public/samarth-bhatia.jpg; importing it lets Astro emit small WebP copies.
const avatarModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar.generated.jpg',
  { eager: true },
);
const avatar = Object.values(avatarModules)[0]?.default;
const initials = `${profile.firstName[0]}${profile.lastName[0]}`;

// DIP packages have an even pin count. Pad with an unconnected pin if needed,
// then number counter-clockwise: left side top→bottom, right side bottom→top.
const totalPins = links.length + (links.length % 2);
const half = totalPins / 2;
const pins = Array.from({ length: totalPins }, (_, i) => {
  const pin = i + 1;
  const left = pin <= half;
  return {
    pin,
    side: left ? ('left' as const) : ('right' as const),
    row: left ? pin : totalPins - pin + 1,
    link: links[i],
  };
});

// Real chips carry a YYWW date code; this one is the build week.
const now = new Date();
const thursday = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
thursday.setUTCDate(thursday.getUTCDate() + 4 - (thursday.getUTCDay() || 7));
const week = Math.ceil(
  ((thursday.getTime() - Date.UTC(thursday.getUTCFullYear(), 0, 1)) / 86400000 + 1) / 7,
);
const dateCode = `${String(thursday.getUTCFullYear()).slice(2)}${String(week).padStart(2, '0')}`;

const telHref = phone ? `tel:${phone.replace(/[^\d+]/g, '')}` : undefined;
---

<div class="px-3 py-6 sm:px-6 md:py-12">
  <div
    class="board relative mx-auto max-w-5xl overflow-hidden rounded-[1.25rem] border border-line bg-surface px-5 pt-9 pb-10 sm:px-8 md:px-12 md:pt-12"
  >
    {
      ['top-4 left-4', 'top-4 right-4', 'bottom-4 left-4', 'bottom-4 right-4'].map((pos) => (
        <span
          class={`absolute ${pos} hidden size-5 rounded-full border-[3px] border-copper bg-ink md:block`}
          aria-hidden="true"
        />
      ))
    }

    <header class="flex flex-col items-center text-center">
      <div class="rounded-full bg-surface p-1.5 ring-2 ring-copper">
        {
          avatar ? (
            <Image
              src={avatar}
              alt={profile.name}
              width={112}
              height={112}
              densities={[1, 2, 3]}
              fit="cover"
              position="center"
              format="webp"
              priority
              class="size-28 rounded-full object-cover"
            />
          ) : (
            <div
              class="flex size-28 items-center justify-center rounded-full bg-epoxy font-display text-3xl font-semibold text-text"
              aria-hidden="true"
            >
              {initials}
            </div>
          )
        }
      </div>

      <p class="mt-5 font-mono text-[0.65rem] tracking-[0.25em] text-muted uppercase">Currently</p>
      <p class="mt-1 text-lg text-text">
        {profile.current.role} at <span class="font-semibold text-accent">{profile.current.org}</span>
      </p>
      <p class="mt-0.5 max-w-sm text-sm text-muted">{profile.current.summary}</p>
    </header>

    <div
      class="pinout mt-9 flex flex-col md:mt-12 md:grid md:grid-cols-[1fr_minmax(15rem,17rem)_1fr]"
      style={`grid-template-rows: repeat(${half}, auto);`}
    >
      <div
        class="chip relative flex flex-col items-center justify-center rounded-lg bg-epoxy px-6 pt-10 pb-8 text-center shadow-[0_18px_40px_rgb(0_0_0/0.35)] md:col-start-2 md:mx-0"
        style={`grid-row: 1 / span ${half};`}
      >
        <span
          class="absolute top-0 left-1/2 h-4 w-9 -translate-x-1/2 rounded-b-full bg-surface"
          aria-hidden="true"></span>
        <span
          class="absolute top-3.5 left-3.5 size-2.5 rounded-full bg-black/70 shadow-[inset_0_1px_2px_rgb(0_0_0/0.9)]"
          aria-hidden="true"></span>
        <span class="absolute top-3 right-3.5 font-mono text-[0.65rem] tracking-widest text-etch">U1</span>

        <h1 class="font-display text-[2.6rem] leading-[0.9] font-semibold tracking-wide text-text uppercase">
          {profile.firstName}<br />{profile.lastName}
        </h1>
        <p class="mt-4 font-mono text-[0.7rem] leading-relaxed tracking-[0.18em] text-etch uppercase">
          CompE + Business<br />NTU · Singapore
        </p>
        <p class="mt-3 font-mono text-[0.65rem] tracking-[0.2em] text-etch" aria-hidden="true">
          {dateCode}
        </p>
      </div>

      <ul
        class="bus relative mt-6 flex flex-col pl-3 before:absolute before:top-0 before:bottom-8 before:left-3 before:w-0.5 before:bg-copper md:contents md:before:hidden"
        role="list"
        aria-label="Links"
      >
        {
          pins.map(({ pin, side, row, link }) =>
            link ? (
              <Pin
                pin={pin}
                side={side}
                row={row}
                id={link.id}
                label={link.label}
                description={link.description}
                url={link.url}
              />
            ) : (
              <Pin pin={pin} side={side} row={row} nc />
            ),
          )
        }
      </ul>
    </div>

    <section class="mx-auto mt-10 max-w-md md:mt-12" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="sr-only">Contact</h2>
      <a
        href={contactHref}
        class="group flex min-h-16 items-center gap-4 rounded-lg border border-accent/45 bg-epoxy px-5 py-4 transition-colors hover:border-accent"
        data-ph-event={CONTACT_SAVE_EVENT}
        data-ph-label={phone ? 'contact-card' : 'contact-public'}
        data-ph-dest={contactHref}
        data-ph-kind="hub"
        data-ph-surface={surface}
      >
        <span class="font-mono text-[0.65rem] tracking-widest text-muted" aria-hidden="true">J1</span>
        <span class="flex flex-1 flex-col">
          <span class="font-display text-xl font-semibold tracking-wide text-text uppercase group-hover:text-accent">
            Save contact
          </span>
          <span class="text-sm text-muted">
            {phone ? 'Adds my number and links to your contacts' : 'Adds my email and links to your contacts'}
          </span>
        </span>
        <span class="text-xl text-accent" aria-hidden="true">↓</span>
      </a>

      {
        phone && telHref && (
          <a
            href={telHref}
            class="mt-3 flex min-h-12 items-center justify-center gap-2 rounded-lg border border-line font-mono text-sm tracking-wider text-text hover:border-accent hover:text-accent"
            data-ph-event={LINK_CLICK_EVENT}
            data-ph-label="call"
            data-ph-dest="tel"
            data-ph-kind="hub"
            data-ph-surface={surface}
          >
            <span class="text-muted">Call</span> {phone}
          </a>
        )
      }
    </section>

    <section class="mx-auto mt-8 max-w-md" aria-labelledby="tp-heading">
      <h2 id="tp-heading" class="sr-only">Social profiles</h2>
      <ul class="flex flex-wrap justify-center gap-x-2 gap-y-2">
        {
          socials.map((s, i) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-11 items-center gap-2 rounded-md px-3 hover:bg-ink/60"
                {...toDataAttrs({ id: s.id, label: s.label, url: s.url, kind: 'social', surface })}
              >
                <span
                  class="size-3 rounded-full border-2 border-copper group-hover:border-accent"
                  aria-hidden="true"
                />
                <span class="font-mono text-[0.65rem] tracking-widest text-muted" aria-hidden="true">
                  TP{i + 1}
                </span>
                <span class="text-sm font-medium text-text group-hover:text-accent">{s.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mx-auto mt-8 max-w-xl text-center text-sm leading-relaxed text-muted">{profile.bio}</p>
  </div>
</div>
