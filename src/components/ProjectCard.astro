---
import type { CollectionEntry } from 'astro:content';
import type { RepoStats } from '../lib/github';
import { toDataAttrs } from '../lib/analytics';

interface Props {
  project: CollectionEntry<'projects'>;
  /** null when GitHub was unreachable or rate-limited — always handled. */
  stats: RepoStats | null;
}

const { project, stats } = Astro.props;
const p = project.data;
const surface = Astro.url.pathname;
const dates = p.end ? `${p.start} – ${p.end}` : p.start;
---

<article class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6">
  <header class="flex flex-col gap-1">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-lg font-semibold text-text">
        {
          p.showcase ? (
            <a href={`/projects/${project.id}`} class="hover:text-accent">
              {p.name}
            </a>
          ) : (
            p.name
          )
        }
      </h3>
      <span class="font-mono text-xs text-muted">{dates}</span>
    </div>
    {p.award && <p class="text-sm text-accent">{p.award}</p>}
  </header>

  <p class="text-sm leading-relaxed text-muted">{p.tagline}</p>

  {
    p.tech.length > 0 && (
      <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
        {p.tech.map((t) => (
          <li class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{t}</li>
        ))}
      </ul>
    )
  }

  <footer class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-2 text-sm">
    {
      p.links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center text-text underline decoration-line underline-offset-4 hover:decoration-accent"
          {...toDataAttrs({
            id: `${project.id}:${link.label.toLowerCase()}`,
            label: link.label,
            url: link.url,
            kind: 'project',
            surface,
          })}
        >
          {link.label}
        </a>
      ))
    }
    {
      p.showcase && (
        <a href={`/projects/${project.id}`} class="inline-flex min-h-11 items-center text-muted hover:text-text">
          Read more →
        </a>
      )
    }
    {/*
      Stats are an enhancement, never part of the layout skeleton: when
      `stats` is null this renders nothing and the card still looks complete.
    */}
    {
      stats && (
        <span class="ml-auto font-mono text-xs text-muted">
          ★ {stats.stars}
          {stats.language && ` · ${stats.language}`}
        </span>
      )
    }
  </footer>
</article>
