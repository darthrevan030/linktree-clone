---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { toDataAttrs } from '../../lib/analytics';

export async function getStaticPaths() {
  // Only showcase projects get a page. The rest are cards on /projects.
  const projects = await getCollection('projects', (p) => p.data.showcase);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
const surface = Astro.url.pathname;
const dates = p.end ? `${p.start} – ${p.end}` : p.start;
---

<Base title={p.name} description={p.tagline}>
  <article class="mx-auto max-w-3xl px-6 pb-8">
    <a href="/projects" class="no-print inline-flex min-h-11 items-center text-sm text-muted hover:text-text">← All projects</a>

    <header class="mt-8 border-b border-line pb-8">
      <p class="font-mono text-xs text-muted">
        {dates}{p.context && ` · ${p.context}`}
      </p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-text">{p.name}</h1>
      {p.award && <p class="mt-2 text-accent">{p.award}</p>}
      <p class="mt-4 text-lg leading-relaxed text-muted">{p.tagline}</p>

      {
        p.links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {p.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg border border-line bg-surface inline-flex min-h-11 items-center px-4 text-sm text-text hover:border-accent"
                {...toDataAttrs({
                  id: `${project.id}:${link.label.toLowerCase()}`,
                  label: link.label,
                  url: link.url,
                  kind: 'project',
                  surface,
                })}
              >
                {link.label} ↗
              </a>
            ))}
          </div>
        )
      }

      {
        p.tech.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tech stack">
            {p.tech.map((t) => (
              <li class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-muted">{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="prose-body mt-8 space-y-5 leading-relaxed text-muted [&_code]:font-mono [&_code]:text-sm [&_code]:text-text [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-text [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-text [&_ul]:space-y-2"
    >
      <Content />
    </div>
  </article>
</Base>
