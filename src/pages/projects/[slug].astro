---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { toDataAttrs } from '../../lib/analytics';

export async function getStaticPaths() {
  // Only showcase projects get a page. The rest are cards on /projects.
  const projects = await getCollection('projects', (p) => p.data.showcase);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
const surface = Astro.url.pathname;
const dates = p.end ? `${p.start} – ${p.end}` : p.start;
---

<Base title={p.name} description={p.tagline}>
  <article class="mx-auto max-w-3xl px-6 pb-8">
    <a
      href="/projects"
      class="no-print inline-flex min-h-11 items-center gap-1.5 font-mono text-xs tracking-widest text-muted uppercase hover:text-accent"
      ><span aria-hidden="true">←</span> All projects</a
    >

    <header class="mt-8 border-b border-line pb-8">
      <p class="font-mono text-xs tracking-wider text-muted">
        <span class="text-accent">U{p.order + 1}</span> · {dates}{p.context && ` · ${p.context}`}
      </p>
      <h1 class="mt-2 font-display text-5xl leading-none font-semibold tracking-wide text-text uppercase">
        {p.name}
      </h1>
      {p.award && <p class="mt-3 text-accent">{p.award}</p>}
      <p class="mt-4 text-lg leading-relaxed text-balance text-muted">{p.tagline}</p>

      {
        p.links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {p.links.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-accent/45 bg-epoxy px-4 font-mono text-xs tracking-widest text-text uppercase hover:border-accent hover:text-accent"
                {...toDataAttrs({
                  id: `${project.id}:${link.label.toLowerCase()}`,
                  label: link.label,
                  url: link.url,
                  kind: 'project',
                  surface,
                })}
              >
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        )
      }

      {
        p.tech.length > 0 && (
          <p class="mt-6 font-mono text-xs leading-relaxed text-muted">
            <span class="sr-only">Tech stack: </span>
            {p.tech.join(' · ')}
          </p>
        )
      }
    </header>

    <div
      class="prose-body mt-8 max-w-[68ch] space-y-5 leading-relaxed text-muted [&_code]:font-mono [&_code]:text-sm [&_code]:text-text [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-wide [&_h2]:text-text [&_h2]:uppercase [&_li]:ml-5 [&_li]:list-disc [&_li]:marker:text-copper [&_strong]:text-text [&_ul]:space-y-2"
    >
      <Content />
    </div>
  </article>
</Base>
