---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { fetchRepoStats } from '../../lib/github';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Fetched in parallel at build time. fetchRepoStats never throws and returns
// null on any failure, so a GitHub outage cannot fail this page.
const stats = await Promise.all(
  projects.map((p) => (p.data.repo ? fetchRepoStats(p.data.repo) : Promise.resolve(null))),
);

const showcaseCount = projects.filter((p) => p.data.showcase).length;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
const inWords = (n: number) => words[n] ?? String(n);
---

<Base
  title="Projects"
  description="Things Samarth Bhatia has built — portfolio analytics, AWS remediation agents, browser extensions, and more."
>
  <div class="mx-auto max-w-3xl px-6 pb-8">
    <header class="py-10">
      <p class="font-mono text-[0.65rem] tracking-[0.25em] text-muted uppercase">
        U2–U{projects.length + 1}
      </p>
      <h1 class="mt-1 font-display text-5xl font-semibold tracking-wide text-text uppercase">Projects</h1>
      <p class="mt-3 max-w-xl text-balance text-muted">
        {projects.length} things I built. {
          showcaseCount > 0 &&
            `The ${inWords(showcaseCount)} with write-ups cover the engineering decisions behind them.`
        }
      </p>
    </header>

    <div class="grid gap-x-4 gap-y-7 sm:grid-cols-2">
      {projects.map((project, i) => <ProjectCard project={project} stats={stats[i] ?? null} />)}
    </div>
  </div>
</Base>
