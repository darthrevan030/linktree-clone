---
import Base from '../layouts/Base.astro';
import LinkButton from '../components/LinkButton.astro';
import { profile } from '../data/profile';
import { links } from '../data/links';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Eager glob rather than a static import: resolves to {} when the photo is
// absent, so the build still succeeds and the initials fallback renders.
// The file is a face-centred crop generated by scripts/crop-avatar.mjs (prebuild)
// from public/samarth-bhatia.jpg; importing it lets Astro emit small WebP copies.
const avatarModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/avatar.generated.jpg',
  { eager: true },
);
const avatar = Object.values(avatarModules)[0]?.default;
const initials = profile.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<Base bare>
  <div class="mx-auto flex min-h-screen max-w-md flex-col px-6 py-16">
    <section class="flex flex-col items-center text-center">
      {
        avatar ? (
          <Image
            src={avatar}
            alt={profile.name}
            width={112}
            height={112}
            densities={[1, 2, 3]}
            fit="cover"
            position="center"
            format="webp"
            priority
            class="size-28 rounded-full border border-line object-cover"
          />
        ) : (
          <div
            class="flex size-28 items-center justify-center rounded-full border border-line bg-surface text-3xl font-semibold tracking-tight text-text"
            aria-hidden="true"
          >
            {initials}
          </div>
        )
      }

      <h1 class="mt-6 text-3xl font-semibold tracking-tight text-text">{profile.name}</h1>
      <p class="mt-1 text-accent">{profile.tagline}</p>
      <p class="mt-4 text-sm leading-relaxed text-muted">{profile.bio}</p>
    </section>

    <nav class="mt-10 flex flex-col gap-3" aria-label="Links">
      {
        links.map((link) => (
          <LinkButton
            id={link.id}
            label={link.label}
            description={link.description}
            url={link.url}
            featured={link.featured}
            kind="hub"
          />
        ))
      }
    </nav>
  </div>
</Base>
