---
import Base from '../layouts/Base.astro';
import Hub from '../components/Hub.astro';
import { profile } from '../data/profile';
import { socials } from '../data/socials';
import { education } from '../data/resume';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.current.role,
    worksFor: {
      '@type': 'Organization',
      name: profile.current.org,
      url: profile.current.url,
    },
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: education[0].institution,
    },
    url: profile.siteUrl,
    sameAs: socials.map((s) => s.url),
    knowsAbout: ['Software Engineering', 'Product Management', 'Cybersecurity', 'Fintech'],
  },
};
---

<Base bare>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  <Hub contactHref="/samarth-bhatia.vcf" />
</Base>
