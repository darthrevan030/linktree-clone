---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import { profile } from '../data/profile';
import { socials } from '../data/socials';
import { toDataAttrs } from '../lib/analytics';

interface Props {
  title?: string;
  description?: string;
  /** Hide the site nav — the hub page is its own navigation. */
  bare?: boolean;
}

const {
  title,
  description = profile.bio,
  bare = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, profile.siteUrl).href;
const ogImage = new URL(profile.ogImage, profile.siteUrl).href;
const surface = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <Analytics />
  </head>
  <body class="min-h-screen">
    {
      !bare && (
        <header class="no-print mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
          <a href="/" class="inline-flex min-h-11 items-center font-semibold tracking-tight text-text hover:text-accent">
            {profile.name}
          </a>
          <nav class="flex gap-6 text-sm text-muted">
            <a href="/projects" class="inline-flex min-h-11 items-center hover:text-text">Projects</a>
            <a href="/resume" class="inline-flex min-h-11 items-center hover:text-text">Resume</a>
          </nav>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="no-print mx-auto max-w-3xl px-6 py-12 text-sm text-muted">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-line pt-6">
        {
          socials.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center hover:text-text"
              {...toDataAttrs({ id: s.id, label: s.label, url: s.url, kind: 'social', surface })}
            >
              {s.label}
            </a>
          ))
        }
        <span class="ml-auto">© {new Date().getFullYear()} {profile.name}</span>
      </div>
    </footer>
  </body>
</html>
