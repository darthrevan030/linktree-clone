# Copy to .env for local development. .env is gitignored — never commit it.

# PostHog project token (EU region). Safe to expose: PostHog project tokens
# are client-side by design. The PUBLIC_ prefix is what lets Astro ship it to
# the browser.
PUBLIC_POSTHOG_KEY=

# GitHub personal access token, public-repo read scope.
# SECRET. Build-time only — never prefix with PUBLIC_, never read it from
# client code. Optional: without it the build still succeeds, but repo stats
# will be intermittently missing (60 req/hr unauthenticated, shared IPs).
GITHUB_TOKEN=

# Private NFC card page (README → "NFC card"). Both must be set, or no card
# page is built. PRIVATE — never prefix with PUBLIC_.
# CARD_KEY: generate with
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CARD_KEY=
# Your number exactly as it should appear in contacts, e.g. +65 9123 4567
CONTACT_PHONE=
